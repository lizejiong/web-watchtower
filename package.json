{
  "name": "web-watchtower",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:phase1": "turbo run dev --filter=@web-monitoring/ingest-api --filter=@web-monitoring/worker --filter=@web-monitoring/playground-react --filter=@web-monitoring/dashboard",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @web-monitoring/playground-react e2e",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "turbo": "^2.0.12",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.0"
  }
}
